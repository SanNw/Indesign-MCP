{
  "name": "mcp-indesign",
  "version": "0.1.0",
  "description": "MCP server for Adobe InDesign automation on Windows",
  "author": "SanNw",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SanNw/Indesign-MCP.git"
  },
  "homepage": "https://github.com/SanNw/Indesign-MCP#readme",
  "bugs": {
    "url": "https://github.com/SanNw/Indesign-MCP/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "os": [
    "win32"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "indesign",
    "adobe",
    "extendscript",
    "automation"
  ],
  "bin": {
    "mcp-indesign": "dist/index.js"
  },
  "mcp": {
    "name": "indesign-mcp",
    "description": "Control Adobe InDesign from Claude via ExtendScript bridge",
    "transport": "stdio"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc && node dist/index.js",
    "watch": "tsc --watch",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "npm run build && node test-mcp.mjs",
    "prepack": "npm run clean && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0"
  }
}
